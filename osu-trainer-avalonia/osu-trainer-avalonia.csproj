<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <!-- Startup is JIT-bound: publishing without R2R measured ~1850ms to first window on a
         dev machine, with R2R ~950ms. This is a no-op unless `dotnet publish` is given a
         RuntimeIdentifier, so plain `dotnet build` output and paths are unaffected — see
         .fable/MAP.md's Build section for the publish command that actually engages it. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="LucideAvalonia" Version="1.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\osu-trainer-core\osu-trainer-core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="osu-trainer-avalonia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/Quicksand-Variable.ttf" />
    <!-- Generated from Assets/logo.svg by tools/make-icons.py and committed; the svg itself is
         repo source, not a build input, so it stays undeclared. -->
    <AvaloniaResource Include="Assets/logo.ico" />
    <AvaloniaResource Include="Assets/logo-64.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\osu-trainer\binaries\oppai.exe">
      <Link>binaries\oppai.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\osu-trainer\binaries\soundstretch.exe">
      <Link>binaries\soundstretch.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
