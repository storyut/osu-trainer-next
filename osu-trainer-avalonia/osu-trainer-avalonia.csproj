<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <!-- Startup pays two opposite costs: JIT (every launch) and cold page-in (first launch
         after boot). R2R fixes the former; single-file shrinks the page-in cost somewhat by
         cutting the file count. PublishTrimmed was tried in unit 016 and reverted: it measurably
         strips Avalonia's reflection-based automation-peer tree (UI Automation found 0 elements
         in the trimmed build vs. 81 in an untrimmed one), and the app's actual on-screen
         correctness couldn't be independently re-verified that session — see unit 016's work file
         Outcome and LESSONS before re-enabling it. All of these are no-ops unless `dotnet publish`
         is given a RuntimeIdentifier, so plain `dotnet build` output and paths are unaffected —
         see .fable/MAP.md's Build section for the publish command that actually engages them. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\osu-trainer-core\osu-trainer-core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="osu-trainer-avalonia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/Quicksand-Variable.ttf" />
    <!-- Generated from Assets/logo.svg by tools/make-icons.py and committed; the svg itself is
         repo source, not a build input, so it stays undeclared. -->
    <AvaloniaResource Include="Assets/logo.ico" />
    <AvaloniaResource Include="Assets/logo-64.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\osu-trainer\binaries\oppai.exe">
      <Link>binaries\oppai.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\osu-trainer\binaries\soundstretch.exe">
      <Link>binaries\soundstretch.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
