<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:osu_trainer_avalonia.Controls"
        xmlns:lucideAvalonia="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
        x:Class="osu_trainer_avalonia.MainWindow"
        Title="osu-trainer-next"
        Width="400" SizeToContent="Height" CanResize="False"
        SystemDecorations="None"
        Background="{DynamicResource WindowBackground}"
        FontFamily="avares://osu-trainer-avalonia/Assets/Fonts/Quicksand-Variable.ttf#Quicksand">
  <Grid RowDefinitions="Auto,*">
      <!-- 1. Custom title bar (draggable), spanning both columns -->
      <Border x:Name="TitleBar" Grid.Row="0" Background="#14141A" Padding="14,8" PointerPressed="OnTitleBarPressed">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Grid.Column="0" Text="osu!trainer" Foreground="{DynamicResource TextPrimary}"
                     FontWeight="Bold" VerticalAlignment="Center"/>
          <Button Grid.Column="1" x:Name="MinimizeButton" Click="OnMinimizeClick"
                  Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                  Padding="10,2" MinHeight="0" AutomationProperties.AutomationId="MinimizeButton">
            <lucideAvalonia:Lucide Icon="Minus" Width="14" Height="14" StrokeBrush="{DynamicResource TextPrimary}"/>
          </Button>
          <Button Grid.Column="2" x:Name="CloseButton" Click="OnCloseClick"
                  Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                  Padding="10,2" MinHeight="0" AutomationProperties.AutomationId="CloseButton">
            <lucideAvalonia:Lucide Icon="X" Width="14" Height="14" StrokeBrush="{DynamicResource TextPrimary}"/>
          </Button>
        </Grid>
      </Border>

    <!-- Row 1: left content column (fixed 376px) + right extras column (collapsed at rest) -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto">
      <StackPanel Grid.Column="0" Width="376" Margin="12" Spacing="8">
        <!-- Update-available row (hidden until a newer GitHub release is found) -->
        <Grid x:Name="UpdateRow" IsVisible="False" ColumnDefinitions="*,Auto"
              Background="{DynamicResource CardBackground}" Margin="0,0,0,4">
          <Button Grid.Column="0" Click="OnUpdateRowClick" Background="Transparent"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4"
                  AutomationProperties.AutomationId="UpdateRowButton">
            <TextBlock x:Name="UpdateRowText" Text="Update available" Foreground="{DynamicResource AccentPink}"
                       FontSize="{DynamicResource FontSizeCaption}"/>
          </Button>
          <Button Grid.Column="1" Click="OnDismissUpdateRowClick" Background="Transparent"
                  Padding="6,4" MinHeight="0" AutomationProperties.AutomationId="DismissUpdateRowButton">
            <lucideAvalonia:Lucide Icon="X" Width="12" Height="12" StrokeBrush="{DynamicResource TextPrimary}"/>
          </Button>
        </Grid>

        <!-- 2. Beatmap card: artwork, sharp, with a bottom scrim carrying the text.
             Rectangle rather than Image for the same reason unit 003 gave: with
             SizeToContent an Image measures at the bitmap's natural size and stretches
             the window. -->
        <Border Height="86" CornerRadius="{DynamicResource ControlCornerRadius}"
                ClipToBounds="True" Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
          <Grid>
            <Rectangle x:Name="BeatmapCardArt" IsVisible="False"/>
            <Rectangle VerticalAlignment="Bottom" Height="56">
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
                  <GradientStop Offset="0" Color="#E6000000"/>
                  <GradientStop Offset="1" Color="#00000000"/>
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <Grid Margin="10,0,10,8" VerticalAlignment="Bottom" ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="1">
                <StackPanel.Effect>
                  <DropShadowEffect BlurRadius="4" OffsetX="0" OffsetY="1"
                                    Color="Black" Opacity="0.9"/>
                </StackPanel.Effect>
                <TextBlock x:Name="SongTitle" Text="No beatmap loaded." Foreground="{DynamicResource TextPrimary}"
                           FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="SongTitle"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock x:Name="SongArtist" Text="" Foreground="#D8D8E0" FontSize="{DynamicResource FontSizeCaption}"
                             TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="SongArtist"/>
                  <TextBlock x:Name="SongDifficulty" Text="" Foreground="{DynamicResource AccentPink}" FontSize="{DynamicResource FontSizeCaption}"
                             TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="SongDifficulty"/>
                </StackPanel>
              </StackPanel>
              <controls:StarRatingDiamond Grid.Column="1" x:Name="StarRatingDiamond" VerticalAlignment="Bottom"
                                           AutomationProperties.AutomationId="StarRatingDiamond"/>
            </Grid>
          </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Text="No beatmap loaded." Foreground="#B0B0B8" FontSize="{DynamicResource FontSizeCaption}"
                   AutomationProperties.AutomationId="StatusText"/>

        <!-- 3. Rate card -->
        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="12">
          <StackPanel Spacing="6">
            <Slider x:Name="RateSlider" Minimum="0.5" Maximum="2.0" Value="1.0" ValueChanged="OnRateChanged"
                    AutomationProperties.AutomationId="RateSlider"/>
            <!-- Merged rate + BPM readout row -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
              <TextBlock Grid.Column="0" x:Name="RateBpmText" Text="—" Foreground="{DynamicResource TextPrimary}"
                         FontWeight="Bold" VerticalAlignment="Center"
                         AutomationProperties.AutomationId="RateBpmText"/>
              <TextBlock Grid.Column="1" x:Name="BpmRangeText" Text="" Foreground="#B0B0B8" Margin="8,0,0,0"
                         VerticalAlignment="Center" AutomationProperties.AutomationId="BpmRangeText"/>
              <ToggleButton Grid.Column="3" x:Name="BpmLockButton" Click="OnBpmLockClick"
                            Background="Transparent" BorderBrush="{DynamicResource CardBorder}"
                            Padding="8,3" MinHeight="0" AutomationProperties.AutomationId="BpmLockButton">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <lucideAvalonia:Lucide Icon="Lock" Width="12" Height="12" StrokeBrush="{DynamicResource TextPrimary}"/>
                  <TextBlock Text="BPM" Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
              </ToggleButton>
            </Grid>
          </StackPanel>
        </Border>

        <!-- 4. Difficulty card -->
        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="10">
          <StackPanel Spacing="6">
            <controls:DifficultyRow x:Name="HpRow" Label="HP" Minimum="0" Maximum="10"
                                    AutomationProperties.AutomationId="HpRow"/>
            <controls:DifficultyRow x:Name="CsRow" Label="CS" Minimum="0" Maximum="10"
                                    AutomationProperties.AutomationId="CsRow">
              <controls:DifficultyRow.TrailingContent>
                <CheckBox x:Name="HrCsCheck" Content="HR" Click="OnHrClick"
                          ToolTip.Tip="Emulate HardRock circle size (CS ×1.3)"
                          AutomationProperties.AutomationId="HrCsCheck"/>
              </controls:DifficultyRow.TrailingContent>
            </controls:DifficultyRow>
            <controls:DifficultyRow x:Name="ArRow" Label="AR" Minimum="0" Maximum="11"
                                    AutomationProperties.AutomationId="ArRow">
              <controls:DifficultyRow.TrailingContent>
                <CheckBox x:Name="ScaleArCheck" Content="Scale" Click="OnScaleArClick"
                          ToolTip.Tip="Scale AR with rate automatically"
                          AutomationProperties.AutomationId="ScaleArCheck"/>
              </controls:DifficultyRow.TrailingContent>
            </controls:DifficultyRow>
            <controls:DifficultyRow x:Name="OdRow" Label="OD" Minimum="0" Maximum="11"
                                    AutomationProperties.AutomationId="OdRow">
              <controls:DifficultyRow.TrailingContent>
                <CheckBox x:Name="ScaleOdCheck" Content="Scale" Click="OnScaleOdClick"
                          ToolTip.Tip="Scale OD with rate automatically"
                          AutomationProperties.AutomationId="ScaleOdCheck"/>
              </controls:DifficultyRow.TrailingContent>
            </controls:DifficultyRow>
          </StackPanel>
        </Border>

        <!-- 5. Profiles row + More expander -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" x:Name="ProfilesPanel" Orientation="Horizontal" Spacing="4"/>
          <Button Grid.Column="1" x:Name="MoreButton" Click="OnToggleExtras"
                  Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                  BorderBrush="{DynamicResource CardBorder}"
                  AutomationProperties.AutomationId="MoreButton">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <lucideAvalonia:Lucide x:Name="MoreButtonIcon" Icon="ChevronRight" Width="14" Height="14" StrokeBrush="{DynamicResource TextPrimary}"/>
              <TextBlock x:Name="MoreButtonText" Text="More" Foreground="{DynamicResource TextPrimary}"/>
            </StackPanel>
          </Button>
        </Grid>

        <!-- 6. Bottom bar -->
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" x:Name="ResetButton" Click="OnResetClick"
                  Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                  BorderBrush="{DynamicResource CardBorder}"
                  AutomationProperties.AutomationId="ResetButton">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <lucideAvalonia:Lucide Icon="RotateCcw" Width="14" Height="14" StrokeBrush="{DynamicResource TextPrimary}"/>
              <TextBlock Text="Reset" Foreground="{DynamicResource TextPrimary}"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="1" x:Name="GenerateButton" Content="Generate" Click="OnGenerateClick"
                  IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Margin="10,0" AutomationProperties.AutomationId="GenerateButton"/>
          <Button Grid.Column="2" x:Name="SongsFolderButton" Click="OnSongsFolderClick"
                  Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                  BorderBrush="{DynamicResource CardBorder}"
                  AutomationProperties.AutomationId="SongsFolderButton">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <lucideAvalonia:Lucide Icon="Folder" Width="14" Height="14" StrokeBrush="{DynamicResource TextPrimary}"/>
              <TextBlock Text="Songs Folder" Foreground="{DynamicResource TextPrimary}"/>
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>

      <!-- 7. Extras: a right-hand column that appears when the window widens to 720px.
           The left column keeps its 376px width, so nothing in it moves. -->
      <Border Grid.Column="1" x:Name="ExtrasPanel" IsVisible="False" Width="296"
              Margin="0,12,12,12" VerticalAlignment="Top"
              Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
              CornerRadius="{DynamicResource ControlCornerRadius}" Padding="12">
        <StackPanel Spacing="8">
          <CheckBox x:Name="NoSpinnersCheck" Content="No Spinners" Click="OnNoSpinnersClick"
                    AutomationProperties.AutomationId="NoSpinnersCheck"/>
          <CheckBox x:Name="ChangePitchCheck" Content="Change Pitch" Click="OnChangePitchClick"
                    AutomationProperties.AutomationId="ChangePitchCheck"/>
          <CheckBox x:Name="HqMp3Check" Content="High-Quality MP3" Click="OnHqMp3Click"
                    AutomationProperties.AutomationId="HqMp3Check"/>
          <CheckBox x:Name="UpdatesCheck" Content="Check for updates" Click="OnUpdatesCheckClick"
                    AutomationProperties.AutomationId="UpdatesCheck"/>
          <Button x:Name="EditHotkeysButton" Content="Edit Hotkeys (coming soon)" IsEnabled="False"
                  HorizontalAlignment="Left"/>

          <TextBlock Text="Practice cut" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="*,*">
            <TextBox Grid.Column="0" x:Name="PracticeStartBox" Watermark="0:00" Margin="0,0,4,0"
                      AutomationProperties.AutomationId="PracticeStartBox"/>
            <TextBox Grid.Column="1" x:Name="PracticeEndBox" Watermark="0:00" Margin="4,0,0,0"
                      AutomationProperties.AutomationId="PracticeEndBox"/>
          </Grid>

          <TextBlock Text="Rate ladder" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="*,*,*">
            <TextBox Grid.Column="0" x:Name="LadderFromBox" Watermark="1.00" Margin="0,0,4,0"
                      AutomationProperties.AutomationId="LadderFromBox"/>
            <TextBox Grid.Column="1" x:Name="LadderToBox" Watermark="1.00" Margin="4,0,4,0"
                      AutomationProperties.AutomationId="LadderToBox"/>
            <TextBox Grid.Column="2" x:Name="LadderStepBox" Watermark="0.05" Margin="4,0,0,0"
                      AutomationProperties.AutomationId="LadderStepBox"/>
          </Grid>
          <TextBlock x:Name="LadderCountText" Text="1 diffs" Foreground="#B0B0B8"
                     FontSize="{DynamicResource FontSizeCaption}"
                     AutomationProperties.AutomationId="LadderCountText"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
