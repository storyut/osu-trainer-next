<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:osu_trainer_avalonia.Controls"
        x:Class="osu_trainer_avalonia.MainWindow"
        Title="osu-trainer-next"
        Width="480" SizeToContent="Height" CanResize="False"
        SystemDecorations="None"
        Background="{DynamicResource WindowBackground}"
        FontFamily="avares://osu-trainer-avalonia/Assets/Fonts/Quicksand-Variable.ttf#Quicksand">
  <Grid>
    <!-- Hero background (dimmed + blurred) fills the whole window, behind everything.
         Painted as an ImageBrush on a Rectangle rather than an Image element: with
         SizeToContent="Height" an Image reports the bitmap's natural size during measure
         and stretches the window to the wallpaper's height. A Rectangle desires 0 and
         simply stretches to whatever the content stack decides. -->
    <Rectangle x:Name="HeroBackgroundRect" IsVisible="False">
      <Rectangle.Effect>
        <BlurEffect Radius="20"/>
      </Rectangle.Effect>
    </Rectangle>
    <Rectangle Fill="Black" Opacity="0.55"/>

    <StackPanel>
      <!-- 1. Custom title bar (draggable) -->
      <Border x:Name="TitleBar" Background="#14141A" Padding="14,8" PointerPressed="OnTitleBarPressed">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Grid.Column="0" Text="osu!trainer" Foreground="{DynamicResource TextPrimary}"
                     FontWeight="Bold" VerticalAlignment="Center"/>
          <Button Grid.Column="1" x:Name="MinimizeButton" Content="—" Click="OnMinimizeClick"
                  Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                  Padding="10,2" MinHeight="0" AutomationProperties.AutomationId="MinimizeButton"/>
          <Button Grid.Column="2" x:Name="CloseButton" Content="✕" Click="OnCloseClick"
                  Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                  Padding="10,2" MinHeight="0" AutomationProperties.AutomationId="CloseButton"/>
        </Grid>
      </Border>

      <StackPanel Margin="16" Spacing="12">
        <!-- 2. Song display over the dimmed background -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="SongTitle" Text="No beatmap loaded." Foreground="{DynamicResource TextPrimary}"
                       FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="SongTitle"/>
            <TextBlock x:Name="SongArtist" Text="" Foreground="#B0B0B8" FontSize="13"
                       TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="SongArtist"/>
            <TextBlock x:Name="SongDifficulty" Text="" Foreground="{DynamicResource AccentPink}" FontSize="13"
                       TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="SongDifficulty"/>
          </StackPanel>
          <controls:StarRatingDiamond Grid.Column="1" x:Name="StarRatingDiamond" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="StarRatingDiamond"/>
        </Grid>

        <!-- Manual load row + status -->
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" x:Name="PathTextBox" Margin="0,0,8,0"
                   Watermark="Path to a .osu file (auto-fills when osu! is open)"
                   AutomationProperties.AutomationId="PathTextBox"/>
          <Button Grid.Column="1" x:Name="LoadButton" Content="Load" Click="OnLoadClick"
                  AutomationProperties.AutomationId="LoadButton"/>
        </Grid>
        <TextBlock x:Name="StatusText" Text="No beatmap loaded." Foreground="#B0B0B8" FontSize="12"
                   AutomationProperties.AutomationId="StatusText"/>

        <!-- 3. Hero rate card -->
        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1" CornerRadius="14" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="Rate" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold"/>
            <Grid Height="48">
              <Slider x:Name="RateSlider" Width="400" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                      Minimum="0.5" Maximum="2.0" Value="1.0" ValueChanged="OnRateChanged"
                      AutomationProperties.AutomationId="RateSlider"/>
              <Border x:Name="RateBubble" Background="{DynamicResource AccentPink}" CornerRadius="10"
                      Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock x:Name="RateBubbleText" Foreground="White" FontWeight="Bold" Text="1.00x"
                           AutomationProperties.AutomationId="RateBubbleText"/>
              </Border>
            </Grid>
            <!-- BPM readout row -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
              <TextBlock Grid.Column="0" x:Name="BpmText" Text="—" Foreground="{DynamicResource TextPrimary}"
                         FontWeight="Bold" VerticalAlignment="Center"
                         AutomationProperties.AutomationId="BpmText"/>
              <TextBlock Grid.Column="1" x:Name="BpmRangeText" Text="" Foreground="#B0B0B8" Margin="8,0,0,0"
                         VerticalAlignment="Center" AutomationProperties.AutomationId="BpmRangeText"/>
              <ToggleButton Grid.Column="3" x:Name="BpmLockButton" Content="🔒 BPM" Click="OnBpmLockClick"
                            Background="Transparent" BorderBrush="{DynamicResource CardBorder}"
                            Padding="8,3" MinHeight="0" AutomationProperties.AutomationId="BpmLockButton"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- 4. Difficulty card -->
        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1" CornerRadius="14" Padding="16">
          <StackPanel Spacing="10">
            <controls:DifficultyRow x:Name="HpRow" Label="HP" Minimum="0" Maximum="10"
                                    AutomationProperties.AutomationId="HpRow"/>
            <controls:DifficultyRow x:Name="CsRow" Label="CS" Minimum="0" Maximum="10"
                                    AutomationProperties.AutomationId="CsRow">
              <controls:DifficultyRow.TrailingContent>
                <CheckBox x:Name="HrCsCheck" Content="HR" Click="OnHrClick"
                          ToolTip.Tip="Emulate HardRock circle size (CS ×1.3)"
                          AutomationProperties.AutomationId="HrCsCheck"/>
              </controls:DifficultyRow.TrailingContent>
            </controls:DifficultyRow>
            <controls:DifficultyRow x:Name="ArRow" Label="AR" Minimum="0" Maximum="11"
                                    AutomationProperties.AutomationId="ArRow">
              <controls:DifficultyRow.TrailingContent>
                <CheckBox x:Name="ScaleArCheck" Content="Scale" Click="OnScaleArClick"
                          ToolTip.Tip="Scale AR with rate automatically"
                          AutomationProperties.AutomationId="ScaleArCheck"/>
              </controls:DifficultyRow.TrailingContent>
            </controls:DifficultyRow>
            <controls:DifficultyRow x:Name="OdRow" Label="OD" Minimum="0" Maximum="11"
                                    AutomationProperties.AutomationId="OdRow">
              <controls:DifficultyRow.TrailingContent>
                <CheckBox x:Name="ScaleOdCheck" Content="Scale" Click="OnScaleOdClick"
                          ToolTip.Tip="Scale OD with rate automatically"
                          AutomationProperties.AutomationId="ScaleOdCheck"/>
              </controls:DifficultyRow.TrailingContent>
            </controls:DifficultyRow>
          </StackPanel>
        </Border>

        <!-- 5. Profiles row + More expander -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" x:Name="ProfilesPanel" Orientation="Horizontal" Spacing="6"/>
          <Button Grid.Column="1" x:Name="MoreButton" Content="▶ More" Click="OnToggleExtras"
                  Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                  BorderBrush="{DynamicResource CardBorder}"
                  AutomationProperties.AutomationId="MoreButton"/>
        </Grid>

        <!-- 6. Extras (collapsible) -->
        <Border x:Name="ExtrasPanel" IsVisible="False" Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="16">
          <StackPanel Spacing="8">
            <CheckBox x:Name="NoSpinnersCheck" Content="No Spinners" Click="OnNoSpinnersClick"
                      AutomationProperties.AutomationId="NoSpinnersCheck"/>
            <CheckBox x:Name="ChangePitchCheck" Content="Change Pitch" Click="OnChangePitchClick"
                      AutomationProperties.AutomationId="ChangePitchCheck"/>
            <CheckBox x:Name="HqMp3Check" Content="High-Quality MP3" Click="OnHqMp3Click"
                      AutomationProperties.AutomationId="HqMp3Check"/>
            <CheckBox x:Name="UpdatesCheck" Content="Check for updates (coming soon)" IsEnabled="False"/>
            <Button x:Name="EditHotkeysButton" Content="Edit Hotkeys (coming soon)" IsEnabled="False"
                    HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>

        <!-- 7. Bottom bar -->
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" x:Name="ResetButton" Content="Reset" Click="OnResetClick"
                  Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                  BorderBrush="{DynamicResource CardBorder}"
                  AutomationProperties.AutomationId="ResetButton"/>
          <Button Grid.Column="1" x:Name="GenerateButton" Content="Generate" Click="OnGenerateClick"
                  IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Margin="10,0" AutomationProperties.AutomationId="GenerateButton"/>
          <Button Grid.Column="2" x:Name="SongsFolderButton" Content="Songs Folder" Click="OnSongsFolderClick"
                  Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                  BorderBrush="{DynamicResource CardBorder}"
                  AutomationProperties.AutomationId="SongsFolderButton"/>
        </Grid>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
