<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             x:Class="osu_trainer_avalonia.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground">#0F0F14</SolidColorBrush>
        <SolidColorBrush x:Key="CardBackground">#1C1C24</SolidColorBrush>
        <SolidColorBrush x:Key="CardBorder">#2A2A35</SolidColorBrush>
        <SolidColorBrush x:Key="AccentPink">#FF66AA</SolidColorBrush>
        <SolidColorBrush x:Key="AccentPinkDim">#CC5588</SolidColorBrush>
        <SolidColorBrush x:Key="TextPrimary">#F0F0F0</SolidColorBrush>

        <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>

        <sys:Double x:Key="FontSizeTitle">15</sys:Double>
        <sys:Double x:Key="FontSizeBody">12</sys:Double>
        <sys:Double x:Key="FontSizeCaption">11</sys:Double>
        <sys:Double x:Key="FontSizeHeader">13</sys:Double>

        <SolidColorBrush x:Key="ButtonBackground">#FF66AA</SolidColorBrush>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver">#FF80BB</SolidColorBrush>
        <SolidColorBrush x:Key="ButtonBackgroundPressed">#CC5588</SolidColorBrush>
        <SolidColorBrush x:Key="ButtonBackgroundDisabled">#3A3A44</SolidColorBrush>

        <SolidColorBrush x:Key="SliderTrackFill">#3A3A44</SolidColorBrush>
        <SolidColorBrush x:Key="SliderTrackFillPointerOver">#454550</SolidColorBrush>
        <SolidColorBrush x:Key="SliderTrackFillPressed">#454550</SolidColorBrush>
        <SolidColorBrush x:Key="SliderTrackValueFill">#FF66AA</SolidColorBrush>
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver">#FF80BB</SolidColorBrush>
        <SolidColorBrush x:Key="SliderTrackValueFillPressed">#FF80BB</SolidColorBrush>
        <SolidColorBrush x:Key="SliderThumbBackground">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver">#FF66AA</SolidColorBrush>
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed">#FF66AA</SolidColorBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Compact pass: shrink Fluent's default control chrome to fit the smaller window. -->
        <Style Selector="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="ToggleButton">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="28" />
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="0 0 16 0 #80FF66AA" />
        </Style>

        <!-- Fluent's checkbox/toggle "checked" fill defaults to the system purple accent,
             which clashes with the pink theme; repoint both at AccentPink. -->
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource AccentPink}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPink}" />
        </Style>
        <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentPink}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPink}" />
        </Style>
    </Application.Styles>
</Application>
