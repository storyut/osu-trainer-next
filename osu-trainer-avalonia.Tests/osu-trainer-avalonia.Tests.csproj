<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\osu-trainer-avalonia\osu-trainer-avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\minimal.osu">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 0-byte, hand-created: BuildArtifact's "audio already exists" branch only probes for
         presence, and nothing on that path decodes it. No third-party audio in this repo. -->
    <None Include="Fixtures\audio.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- IconAssetTests reads the committed ICO's frame table byte by byte. -->
    <None Include="..\osu-trainer-avalonia\Assets\logo.ico">
      <Link>Assets\logo.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
